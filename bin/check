#!/usr/bin/env bash
# Usage: bin/check [gate|harness|all]. No argument runs gates whose paths changed vs main; harness always runs.
set -u
cd "$(dirname "$0")/.."

git config core.hooksPath >/dev/null 2>&1 || git config core.hooksPath .githooks

harness_bad() {
  git ls-files .claude | rg -v '^\.claude/skills$'
  if [ -e .claude/skills ] || [ -L .claude/skills ]; then
    [ "$(readlink .claude/skills)" = "../.agents/skills" ] || echo .claude/skills
  fi
}

run_harness() {
  local bad
  bad=$(harness_bad)
  if [ -n "$bad" ]; then
    printf '%s\n' "$bad" >&2
    echo "✗ harness: .claude must hold only the skills link" >&2
    exit 1
  fi
  echo "✓ harness: .claude holds only the skills link"
}

GATES="swift"
gate_paths_swift="Package.swift Sources Tests"

step_swift_build() { swift build 2>&1; }
step_swift_test() { swift test 2>&1; }
steps_swift="build test"

changed() {
  local base
  base=$(git merge-base HEAD main 2>/dev/null || echo HEAD)
  { git diff --name-only "$base"; git ls-files --others --exclude-standard; } 2>/dev/null
}

run_gate() {
  local g=$1 s out
  for s in $(eval echo "\$steps_$g"); do
    if ! out=$("step_${g}_${s}"); then
      printf '✗ %s: %s\n%s\n' "$g" "$s" "$out"
      return 1
    fi
    printf '✓ %s: %s\n' "$g" "$s"
  done
}

arg=${1:-}
case "$arg" in ""|all|harness) run_harness ;; esac
[ "$arg" = harness ] && exit 0
if [ "$arg" = all ]; then sel=$GATES
elif [ -n "$arg" ]; then sel=$arg
else
  sel=""
  files=$(changed)
  for g in $GATES; do
    for p in $(eval echo "\$gate_paths_$g"); do
      if printf '%s\n' "$files" | rg -q "^${p}(/|\$)"; then sel="$sel $g"; break; fi
    done
  done
fi

rc=0
for g in $sel; do
  case " $GATES " in *" $g "*) ;; *) echo "unknown gate: $g (gates: $GATES harness)" >&2; exit 2;; esac
  run_gate "$g" || rc=1
done
exit $rc
